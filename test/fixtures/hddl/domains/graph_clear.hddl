(define (domain graph_clear)
  (:requirements :strips :typing :temporal :hierarchical)

  (:aria-domain-metadata
    :id "01234567-89ab-cdef-0123-456789abcdef"
    :name "Graph Clear Domain"
    :description "HDDL domain for graph clearing problem - clearing nodes in a graph with constraints"
    :domain-type navigation
    :version 1
    :state active
  )

  (:predicates
    (node ?node_id)
    (edge ?from ?to)
    (cleared ?node)
    (agent_at ?agent ?node)
    (can_clear ?node)
  )

  (:action clear_node
    :parameters (?agent ?node)
    :precondition (and (agent_at ?agent ?node) (can_clear ?node))
    :effect (cleared ?node)
  )

  (:action move_agent
    :parameters (?agent ?from ?to)
    :precondition (and (agent_at ?agent ?from) (edge ?from ?to))
    :effect (and (not (agent_at ?agent ?from)) (agent_at ?agent ?to))
  )

  (:task clear_graph
    :parameters ()
  )

  (:method clear_all
    :task (clear_graph)
    :precondition ()
    :subtasks (visit_all_nodes clear_all_nodes)
  )

  (:command c_clear_node
    :parameters (?agent ?node)
  )
)
