(define (domain train_scheduling)
  (:requirements :strips :typing :temporal :hierarchical)

  (:aria-domain-metadata
    :id "01234567-89ab-cdef-0123-456789abcdef"
    :name "Train Scheduling Domain"
    :description "HDDL domain for train scheduling problems - scheduling trains on routes with stops, platforms, and timing constraints"
    :domain-type navigation
    :version 1
    :state active
  )

  (:predicates
    (at ?train ?stop)
    (platform ?stop ?platform_num)
    (travel_time ?from ?to ?time)
    (service_start ?service ?time)
    (service_end ?service ?time)
    (route ?service ?route_id)
    (makespan ?time)
    (min_sep ?time)
    (engine_assigned ?engine ?service)
    (stop_type ?stop ?type)
    (line_type ?from ?to ?type)
  )

  (:action move_train
    :parameters (?train ?from ?to)
    :precondition (and (at ?train ?from) (travel_time ?from ?to ?time))
    :effect (and (not (at ?train ?from)) (at ?train ?to))
  )

  (:action assign_engine
    :parameters (?engine ?service)
    :precondition (and (not (engine_assigned ?engine ?service)))
    :effect (engine_assigned ?engine ?service)
  )

  (:task schedule_trains
    :parameters ()
  )

  (:method schedule_route
    :task (schedule_trains)
    :precondition ()
    :subtasks (schedule_all_routes)
  )

  (:command c_schedule_service
    :parameters (?service ?route ?start_time)
  )
)
