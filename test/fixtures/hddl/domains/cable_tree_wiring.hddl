(define (domain cable_tree_wiring)
  (:requirements :strips :typing :temporal :hierarchical)

  (:aria-domain-metadata
    :id "01234567-89ab-cdef-0123-456789abcdef"
    :name "Cable Tree Wiring Domain"
    :description "HDDL domain for cable tree wiring problem - routing cables through a tree structure"
    :domain-type navigation
    :version 1
    :state active
  )

  (:predicates
    (node ?node_id)
    (cable ?cable_id)
    (cable_at_node ?cable ?node)
    (connected ?node1 ?node2)
    (routed ?cable ?path)
    (wired ?cable)
  )

  (:action route_cable
    :parameters (?cable ?from ?to)
    :precondition (and (cable_at_node ?cable ?from) (connected ?from ?to))
    :effect (and (not (cable_at_node ?cable ?from)) (cable_at_node ?cable ?to) (routed ?cable ?path))
  )

  (:task wire_cables
    :parameters ()
  )

  (:method wire_all
    :task (wire_cables)
    :precondition ()
    :subtasks (route_all_cables)
  )

  (:command c_route_cable
    :parameters (?cable ?path)
  )
)
