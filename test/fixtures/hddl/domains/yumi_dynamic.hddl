(define (domain yumi_dynamic)
  (:requirements :strips :typing :temporal :hierarchical)

  (:aria-domain-metadata
    :id "01234567-89ab-cdef-0123-456789abcdef"
    :name "Yumi Dynamic Domain"
    :description "HDDL domain for Yumi dynamic planning - robotic arm manipulation with zones and grid setup"
    :domain-type navigation
    :version 1
    :state active
  )

  (:predicates
    (robot ?robot_id)
    (zone ?zone_id)
    (grid_position ?x ?y)
    (robot_at ?robot ?x ?y)
    (zone_at ?zone ?x ?y)
    (can_move ?robot ?from_x ?from_y ?to_x ?to_y)
    (task_completed ?task)
  )

  (:action move_robot
    :parameters (?robot ?from_x ?from_y ?to_x ?to_y)
    :precondition (and (robot_at ?robot ?from_x ?from_y) (can_move ?robot ?from_x ?from_y ?to_x ?to_y))
    :effect (and (not (robot_at ?robot ?from_x ?from_y)) (robot_at ?robot ?to_x ?to_y))
  )

  (:task execute_tasks
    :parameters ()
  )

  (:method execute_all
    :task (execute_tasks)
    :precondition ()
    :subtasks (move_to_zones complete_tasks)
  )

  (:command c_move_robot
    :parameters (?robot ?x ?y)
  )
)
