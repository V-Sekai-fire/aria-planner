(define (problem fox_geese_corn_problem)
  (:domain fox_geese_corn)

  ; Plan structure
  (:aria-plan
    :id "01234567-89ab-cdef-0123-456789abcdef"
    :name "Transport All Items Plan"
    :persona-id "persona_123"
    :domain-type navigation
    :objectives (
      (transport_all items)
    )
    :constraints (
      (:constraint safe_state :type boolean :value true)
    )
    :temporal-constraints (
      (:constraint max_duration :value "PT1H")
    )
    :entity-capabilities (
      (:entity agent_1 :capabilities (:navigation :transport))
    )
    :execution-status planned
    :success-probability 0.85
    :risk-assessment (
      (:risk unsafe_state :probability 0.15)
    )
    :performance-metrics (
      (:metric expected_duration :value "PT45M")
    )
  )

  ; Initial planner state
  ; Classic fox-geese-corn puzzle: f=1, g=1, c=1, k=2
  ; Expected solution: transport geese (0,1,0), return empty (0,0,0), transport fox+corn (1,0,1)
  ; Total trips: 3
  (:aria-initial-state
    :current-time "2025-01-01T10:00:00Z"
    :timeline (
      (:event start :time "2025-01-01T10:00:00Z")
    )
    :entity-capabilities (
      (:entity agent_1 :capabilities (:navigation :transport))
    )
    :facts (
      ; MiniZinc parameters: f=1, g=1, c=1, k=2, t=10, pf=4, pg=4, pc=3
      ; Format: (:fact predicate subject :value value)
      (:fact west_fox state :value 1)
      (:fact west_geese state :value 1)
      (:fact west_corn state :value 1)
      (:fact east_fox state :value 0)
      (:fact east_geese state :value 0)
      (:fact east_corn state :value 0)
      (:fact boat_location state :value west)
      (:fact boat_capacity state :value 2)
      ; Point values for objective calculation (pf, pg, pc)
      (:fact pf state :value 4)
      (:fact pg state :value 4)
      (:fact pc state :value 3)
      ; Maximum trips allowed (t)
      (:fact max_trips state :value 10)
    )
  )

  ; Blacklist (for failure handling)
  (:aria-blacklist
    :blacklisted-commands ()
    :blacklisted-methods ()
  )
)
